{
  "name": "cf-whiteboard",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WHITEBOARD",
        "class_name": "Whiteboard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Whiteboard"]
    }
  ],
  // 可选：绑定自己的域名（大陆访问 workers.dev 不稳定，建议配置）。
  // 不要把真实域名提交到公开仓库——复制本文件为 wrangler.local.jsonc 并加入：
  //   "routes": [{ "pattern": "board.yourdomain.com", "custom_domain": true }]
  // 然后用 `wrangler deploy -c wrangler.local.jsonc` 部署。
  "observability": {
    "enabled": true
  }
}
